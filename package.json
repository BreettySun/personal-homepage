{
  "name": "personal-homepage",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "fonts": "node scripts/subset-fonts.mjs",
    "fallback": "node scripts/render-fallback.mjs",
    "prebuild": "npm run fonts",
    "build": "vite-ssg build",
    "postbuild": "node -e \"require('fs').copyFileSync('dist/404/index.html','dist/404.html')\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:update": "npm run build && playwright test --update-snapshots",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@unhead/vue": "^2.1.17",
    "gsap": "^3.15.0",
    "markdown-it": "^15.0.1",
    "simplex-noise": "^4.0.3",
    "three": "^0.186.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.2",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "jsdom": "^30.0.1",
    "subset-font": "^2.7.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-ssg": "^28.3.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}
